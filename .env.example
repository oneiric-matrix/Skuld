# ==============================================
# Application Configuration Blueprint
# ==============================================
# Copy this file to '.env' and adjust the values for your local environment.
# Never commit real secrets or production credentials to version control.

# Server / Runtime Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database / Storage (Optional Blueprint)
DATABASE_URL=postgresql://user:password@localhost:5432/app_db
REDIS_URL=redis://localhost:6379

# Authentication & Security Secrets (Generate unique keys per environment)
AUTH_SECRET=your_super_secret_jwt_key_minimum_32_characters
CORS_ORIGIN=http://localhost:3000

# External Integrations (Blueprint)
# API_KEY=
# SENTRY_DSN=
