<?xml version="1.0" encoding="utf-8"?>
<!-- Skuld Android Quick-Talk Home Screen Widget RemoteViews Layout -->
<!-- Nordic Dark Obsidian Theme (#0A0A12) with Glacial Cyan Accents (#00E5FF) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/skuld_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/skuld_widget_background"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Nordic Runic Emblem Orb Button -->
    <LinearLayout
        android:id="@+id/btn_widget_talk"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/skuld_widget_orb_cyan"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙️"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Center Agent Status Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SKULD QUICK TALK"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to wake Butler &amp; speak"
            android:textColor="#DCE4EC"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Quick Scan Button -->
    <LinearLayout
        android:id="@+id/btn_widget_scan"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/skuld_widget_action_btn"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
